# Copie para .env e preencha.
# (o .env não é versionado — nunca comite chaves)

# Porta do HQ Bridge (backend local)
PORT=4173

# URL base do servidor OmniRoute (endpoint OpenAI-compatível)
OMNI_URL=http://localhost:20128

# Chave de API do OmniRoute, se o seu servidor exigir (Authorization: Bearer)
OMNI_API_KEY=

# Modelo/rota/target no OmniRoute.
# Ex.: um modelo open específico (ex. "deepseek/deepseek-chat", "openrouter/qwen-2.5-72b")
#      ou um combo/target "auto" para usar o auto-routing do OmniRoute.
OMNI_MODEL=

# Token opcional exigido no header X-HQ-Token pelo front (recomendado publicar)
HQ_TOKEN=

# Timeout da geração (ms)
OMNI_TIMEOUT_MS=120000

# ---- MongoDB Atlas (persistência real) ----
# Conexão usa hosts diretos (non-SRV), pois algumas redes não resolvem o TXT do
# mongodb+srv://. Se MONGO_URI estiver preenchida, ela tem precedência.
MONGO_URI=
MONGO_HOSTS=ac-dv5oy5v-shard-00-00.example.mongodb.net:27017,ac-dv5oy5v-shard-00-01.example.mongodb.net:27017,ac-dv5oy5v-shard-00-02.example.mongodb.net:27017
MONGO_USER=
MONGO_PASS=
MONGO_DB=kraefeggmo
MONGO_RS=atlas-xxxx-shard-0
